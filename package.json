{
  "name": "r3f-table-tennis",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "node tests/engine.test.mjs && node tests/equipment.test.mjs && node tests/swing.test.mjs && node tests/phone-motion.test.mjs && node tests/practice-player.test.mjs && node tests/simulated-swings.test.mjs && node tests/phone-platform.test.mjs && npm run test:multiplayer",
    "controller": "node controller/server.mjs",
    "test:controller": "node tests/controller.test.mjs && node tests/phone-feedback.test.mjs",
    "trial:compare": "node controller/compare-tracker.mjs",
    "trial:simulate": "node controller/simulate-swings.mjs",
    "trial:analyze": "node controller/analyze-trial.mjs",
    "replay:prepare": "node controller/export-replay.mjs",
    "predev": "node controller/prepare-phone.mjs",
    "prebuild": "node controller/prepare-phone.mjs && node controller/prepare-pose.mjs",
    "cloud:template": "node cloud/template.mjs",
    "test:cloud": "node tests/cloud-relay.test.mjs",
    "test:multiplayer": "node multiplayer/build.mjs && node tests/multiplayer.test.mjs",
    "multiplayer": "node multiplayer/build.mjs && node multiplayer/local.mjs",
    "test:multiplayer:cloud": "node tests/multiplayer-cloud.test.mjs",
    "multiplayer:template": "node multiplayer/template.mjs",
    "multiplayer:deploy": "node multiplayer/template.mjs && node multiplayer/deploy.mjs",
    "pose:prepare": "node controller/prepare-pose.mjs",
    "pose:dev": "npm run pose:prepare && vite --host 127.0.0.1 --port 5174 --strictPort",
    "test:pose": "node tests/pose.test.mjs",
    "test:webcam": "node tests/webcam.test.mjs && node tests/free-hand.test.mjs && node tests/onboarding.test.mjs && node tests/paddle-tracking.test.mjs && node tests/paddle-frame.test.mjs && node tests/orientation-trial.test.mjs && node tests/playtest-recording.test.mjs && node tests/session-marker.test.mjs",
    "pose:analyze": "node controller/analyze-pose.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@mediapipe/tasks-vision": "1.1.1",
    "@react-spring/three": "^9.7.3",
    "@react-three/drei": "^9.105.6",
    "@react-three/fiber": "^8.16.3",
    "@react-three/rapier": "^1.3.1",
    "gsap": "^3.12.5",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.164.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.1152.0",
    "@aws-sdk/client-dynamodb": "^3.1152.0",
    "@aws-sdk/lib-dynamodb": "^3.1152.0",
    "@react-spring/types": "^9.7.3",
    "@types/gsap": "^3.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/three": "^0.164.0",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "esbuild": "^0.21.5",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "typescript": "^5.2.2",
    "vite": "^5.2.0"
  }
}
